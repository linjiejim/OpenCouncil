# Database
DATABASE_URL=postgresql://opencouncil:opencouncil@localhost:5433/opencouncil

# Model provider (any OpenAI-compatible API). Unset LLM_* fall back to DEEPSEEK_*.
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=deepseek/deepseek-v4-flash
# LLM_EXTRA_BODY={"reasoning":{"enabled":false}}

# Spending limits for the public endpoints that call the model
# (per IP: burst 5, then 20 questions an hour; site-wide: model calls per UTC day)
COUNCIL_DAILY_LIMIT=300

# Server
API_PORT=3001
